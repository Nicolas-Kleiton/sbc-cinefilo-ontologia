# -----------------------------------------------------------------------------
#  Pessoas
#  Cada pessoa declara só o papel principal. Os demais papéis são inferidos
#  pelo rdfs:range das propriedades: Nolan vira Roteirista porque roteirizou
#  filmes, e Eastwood vira Ator porque está no elenco de Menina de Ouro.
# -----------------------------------------------------------------------------

# Diretores
cine:nolan a cine:Diretor ;
    rdfs:label "Christopher Nolan" ;
    cine:anoNascimento 1970 ;
    cine:nacionalidade "Reino Unido" ;
    cine:colaborouCom cine:zimmer , cine:jonathanNolan , cine:murphy .

cine:villeneuve a cine:Diretor ;
    rdfs:label "Denis Villeneuve" ;
    cine:anoNascimento 1967 ;
    cine:nacionalidade "Canadá" ;
    cine:colaborouCom cine:zimmer .

cine:kubrick a cine:Diretor ;
    rdfs:label "Stanley Kubrick" ;
    cine:anoNascimento 1928 ;
    cine:nacionalidade "EUA" ;
    cine:influenciou cine:nolan , cine:peele .

cine:peele a cine:Diretor ;
    rdfs:label "Jordan Peele" ;
    cine:anoNascimento 1979 ;
    cine:nacionalidade "EUA" .

cine:bongJoonHo a cine:Diretor ;
    rdfs:label "Bong Joon-ho" ;
    cine:anoNascimento 1969 ;
    cine:nacionalidade "Coreia do Sul" ;
    cine:colaborouCom cine:songKangHo .

cine:eastwood a cine:Diretor ;
    rdfs:label "Clint Eastwood" ;
    cine:anoNascimento 1930 ;
    cine:nacionalidade "EUA" ;
    cine:colaborouCom cine:freeman .

cine:lasseter a cine:Diretor ;
    rdfs:label "John Lasseter" ;
    cine:anoNascimento 1957 ;
    cine:nacionalidade "EUA" ;
    cine:colaborouCom cine:unkrich .

cine:unkrich a cine:Diretor ;
    rdfs:label "Lee Unkrich" ;
    cine:anoNascimento 1967 ;
    cine:nacionalidade "EUA" .

cine:chin a cine:Diretor ;
    rdfs:label "Jimmy Chin" ;
    cine:anoNascimento 1973 ;
    cine:nacionalidade "EUA" ;
    cine:colaborouCom cine:vasarhelyi .

cine:vasarhelyi a cine:Diretor ;
    rdfs:label "Elizabeth Chai Vasarhelyi" ;
    cine:anoNascimento 1979 ;
    cine:nacionalidade "EUA" .

# A cadeia de influência que a transitividade completa:
# Kubrick → Nolan → Villeneuve
cine:nolan cine:influenciou cine:villeneuve .

# Roteiristas
cine:jonathanNolan a cine:Roteirista ;
    rdfs:label "Jonathan Nolan" ;
    cine:anoNascimento 1976 ;
    cine:nacionalidade "Reino Unido" .

cine:clarke a cine:Roteirista ;
    rdfs:label "Arthur C. Clarke" ;
    cine:anoNascimento 1917 ;
    cine:nacionalidade "Reino Unido" .

cine:haggis a cine:Roteirista ;
    rdfs:label "Paul Haggis" ;
    cine:anoNascimento 1953 ;
    cine:nacionalidade "Canadá" .

# Compositores
cine:zimmer a cine:Compositor ;
