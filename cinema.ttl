    cine:anoNascimento 1957 ;
    cine:nacionalidade "Alemanha" .

cine:goransson a cine:Compositor ;
    rdfs:label "Ludwig Göransson" ;
    cine:anoNascimento 1984 ;
    cine:nacionalidade "Suécia" .

cine:johannsson a cine:Compositor ;
    rdfs:label "Jóhann Jóhannsson" ;
    cine:anoNascimento 1969 ;
    cine:nacionalidade "Islândia" .

cine:newman a cine:Compositor ;
    rdfs:label "Randy Newman" ;
    cine:anoNascimento 1943 ;
    cine:nacionalidade "EUA" .

# Atores
